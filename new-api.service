# File path: /etc/systemd/system/app.service
# sudo systemctl daemon-reload
# sudo systemctl start app
# sudo systemctl enable app
# sudo systemctl status app
[Unit]
Description=One API Service
After=network.target

[Service]
User=ubuntu  # 注意修改用户名
WorkingDirectory=/path/to/app  # 注意修改路径
ExecStart=/path/to/app/app --port 3000 --log-dir /path/to/app/logs  # 注意修改路径和端口号
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
